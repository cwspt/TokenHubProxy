<Window x:Class="TokenHubProxyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenHub Responses Proxy Launcher"
        MinHeight="760"
        MinWidth="1220"
        Height="820"
        Width="1260"
        Icon="Assets/TokenHubProxyLauncher.ico"
        Background="#F6F7F9">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,8,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" Text="TokenHub Responses Proxy Launcher" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleTextBlock" Text="Configure, probe, and run the local Responses-to-TokenHub proxy without editing scripts." Foreground="#526071" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="LanguageComboBox"
                          Width="112"
                          Height="30"
                          Margin="0,0,10,0"
                          SelectionChanged="LanguageComboBox_SelectionChanged" />
                <Border Background="#FFFFFF" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#A0A7B3" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="Stopped" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox x:Name="ProjectGroupBox" Header="Project" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <Label x:Name="ProjectRootLabel" Content="Project root" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProjectRootTextBox" Grid.Column="0" VerticalAlignment="Center" />
                                <Button x:Name="BrowseProjectButton" Grid.Column="2" Content="Browse" Height="30" Margin="0" VerticalAlignment="Center" Click="BrowseProjectButton_Click" />
                            </Grid>

                            <Label x:Name="PythonCommandLabel" Content="Python command for creating .venv" />
                            <TextBox x:Name="PythonCommandTextBox" Text="python" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="TokenHubGroupBox" Header="TokenHub" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <Label Content="TOKENHUB_API_KEY" />
                            <PasswordBox x:Name="TokenHubApiKeyBox" />
                            <TextBlock x:Name="TokenHubKeyHintTextBlock" Text="Only stored in this launcher process and child proxy process." Foreground="#697386" FontSize="12" Margin="0,4,0,0" />

                            <Label x:Name="BaseUrlLabel" Content="Base URL" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TokenHubBaseUrlTextBox" Grid.Column="0" Text="https://tokenhub.tencentmaas.com/plan/v3/chat/completions" VerticalAlignment="Center" />
                                <Button x:Name="UseTokenHubBaseUrlButton" Grid.Column="2" Content="TokenHub" Height="30" Margin="0" Padding="8,0" VerticalAlignment="Center" Click="UseTokenHubBaseUrlButton_Click" />
                                <Button x:Name="UseDeepSeekBaseUrlButton" Grid.Column="4" Content="DeepSeek" Height="30" Margin="0" Padding="8,0" VerticalAlignment="Center" Click="UseDeepSeekBaseUrlButton_Click" />
                            </Grid>

                            <Label x:Name="ModelLabel" Content="Model" />
                            <TextBox x:Name="TokenHubModelTextBox" Text="glm-5.1" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="LocalProxyGroupBox" Header="Local proxy" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <Label Content="CODEX_GLM_PROXY_KEY" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CodexProxyKeyTextBox" Grid.Column="0" VerticalAlignment="Center" />
                                <Button x:Name="GenerateProxyKeyButton" Grid.Column="2" Content="Generate" Height="30" Margin="0" VerticalAlignment="Center" Click="GenerateProxyKeyButton_Click" />
                            </Grid>
                            <CheckBox x:Name="PersistCodexProxyKeyCheckBox" Content="Persist CODEX_GLM_PROXY_KEY to Windows user environment" IsChecked="True" Margin="0,8,0,0" />

                            <Label x:Name="UpstreamPresetLabel" Content="Upstream preset" />
                            <ComboBox x:Name="UpstreamPresetComboBox"
                                      Height="30"
                                      SelectionChanged="UpstreamPresetComboBox_SelectionChanged" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label x:Name="HostLabel" Content="Host" />
                                    <TextBox x:Name="ProxyHostTextBox" Text="127.0.0.1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label x:Name="PortLabel" Content="Port" />
                                    <TextBox x:Name="ProxyPortTextBox" Text="8787" />
                                </StackPanel>
                            </Grid>

                            <Label x:Name="TimeoutLabel" Content="Timeout seconds" />
                            <TextBox x:Name="TimeoutTextBox" Text="600" />

                            <Label x:Name="ResponseLanguageLabel" Content="Response language" />
                            <ComboBox x:Name="ResponseLanguageComboBox" Height="30" />

                            <CheckBox x:Name="EnableToolCallsCheckBox" Content="Enable tool calls" IsEnabled="False" Margin="0,10,0,0" />
                            <TextBlock x:Name="ToolCallsHintTextBlock" Text="Probe upstream first. The launcher enables tool calls automatically when both tool-call checks pass." TextWrapping="Wrap" Foreground="#697386" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="CodexHomeGroupBox" Header="Isolated CODEX_HOME launchers" Padding="12">
                        <StackPanel>
                            <Label x:Name="DesktopCodexHomeLabel" Content="Desktop CODEX_HOME" />
                            <TextBox x:Name="DesktopCodexHomeTextBox" />
                            <Label x:Name="VsCodeCodexHomeLabel" Content="VS Code CODEX_HOME" />
                            <TextBox x:Name="VsCodeCodexHomeTextBox" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox x:Name="ActionsGroupBox" Grid.Row="0" Header="Actions" Padding="12" Margin="0,0,0,12">
                    <WrapPanel>
                        <Button x:Name="InstallDependenciesButton" Content="Create .venv / Install dependencies" Width="220" Click="InstallDependenciesButton_Click" />
                        <Button x:Name="ProbeButton" Content="Probe upstream" Width="142" Click="ProbeButton_Click" />
                        <Button x:Name="RecoveryMonitorButton" Content="Monitor recovery" Width="154" Click="RecoveryMonitorButton_Click" />
                        <Button x:Name="StartProxyButton" Content="Start proxy" Width="112" Click="StartProxyButton_Click" />
                        <Button x:Name="StopProxyButton" Content="Stop proxy" Width="112" IsEnabled="False" Click="StopProxyButton_Click" />
                        <Button x:Name="HealthCheckButton" Content="Health check" Width="118" Click="HealthCheckButton_Click" />
                        <Button x:Name="OpenConfigButton" Content="Open config" Width="118" Click="OpenConfigButton_Click" />
                        <Button x:Name="LaunchDesktopButton" Content="Launch Desktop" Width="148" ToolTip="Launch Codex Desktop with the configured isolated CODEX_HOME" Click="LaunchDesktopButton_Click" />
                        <Button x:Name="LaunchVsCodeButton" Content="Launch VS Code" Width="148" ToolTip="Launch VS Code with the configured isolated CODEX_HOME" Click="LaunchVsCodeButton_Click" />
                        <Button x:Name="CopyLogButton" Content="Copy log" Width="112" Click="CopyLogButton_Click" />
                        <Button x:Name="ClearLogButton" Content="Clear log" Width="112" Click="ClearLogButton_Click" />
                        <Button x:Name="HelpButton" Content="Help" Width="88" Click="HelpButton_Click" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox x:Name="LogGroupBox" Grid.Row="1" Header="Log" Padding="0">
                    <Grid>
                        <ListBox x:Name="LogListBox"
                                 BorderThickness="0"
                                 Background="#FFFFFF"
                                 SelectionMode="Extended"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               Margin="0,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <TextBlock x:Name="FooterTextBlock"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#697386"
                   Text="Keep this launcher open while the proxy is running. TOKENHUB_API_KEY is not saved to disk by this WPF launcher." />
    </Grid>
</Window>
